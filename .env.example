# --- keys this SERVICE accepts (clients must send one) ------------------
# comma-separated; leave unset/empty to run open
ZIKAI_API_KEYS=
ZIKAI_REQUIRE_KEY=true

# --- decider selection ----------------------------------------------------
# auto = first configured remote, else lexical
ZIKAI_DECIDER=auto

# --- OpenAI ----------------------------------------------------------------
ZIKAI_OPENAI_API_KEY=
ZIKAI_OPENAI_BASE_URL=https://api.openai.com/v1
ZIKAI_OPENAI_MODEL=gpt-4o-mini

# --- Anthropic --------------------------------------------------------------
ZIKAI_ANTHROPIC_API_KEY=
ZIKAI_ANTHROPIC_BASE_URL=https://api.anthropic.com
ZIKAI_ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- generic OpenAI-compatible (laya / sglang / vLLM / deepseek / openrouter)
ZIKAI_LAYA_BASE_URL=
ZIKAI_LAYA_API_KEY=
ZIKAI_LAYA_MODEL=qwen38-next

# --- misc -------------------------------------------------------------------
ZIKAI_DECISION_TIMEOUT_S=20
ZIKAI_DASHBOARD=true
